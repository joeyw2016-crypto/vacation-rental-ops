# ===== vacation_rental_ops 环境变量模板 =====
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，请勿提交真实凭据到仓库。

# Telegram 机器人 Token（BotFather 获取，必填）
TELEGRAM_TOKEN=

# 管理员 Telegram Chat ID（开启房东专属菜单 5/6，选填）
ADMIN_CHAT_ID=

# ClickUp API Token 与 List ID（选填；不配置则降级为仅 CSV 记录）
CLICKUP_TOKEN=
CLICKUP_LIST_ID=

# LLM 配置（选填；不配置则使用内置双语模板回复）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
